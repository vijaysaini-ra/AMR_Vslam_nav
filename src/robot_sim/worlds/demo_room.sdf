<?xml version="1.0"?>
<!-- Demo room for the AMR simulation: 10 x 8 m, two partitions (S-shaped route),
     crates and pillars. Robot spawns at (-4, -3) facing +x; map/odom origin = spawn pose. -->
<sdf version="1.8">
  <world name="demo_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <gui fullscreen="0">
      <camera name="user_camera"><pose>0 -9 9 0 0.8 1.5708</pose></camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane"><static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
      </link></model>

    <model name="wall_north"><static>true</static><pose>0 4.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link></model>
    <model name="wall_south"><static>true</static><pose>0 -4.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link></model>
    <model name="wall_east"><static>true</static><pose>5.05 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 8.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.2 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link></model>
    <model name="wall_west"><static>true</static><pose>-5.05 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 8.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.2 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link></model>
    <model name="partition_1"><static>true</static><pose>-1.0 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 5.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 5.0 1.0</size></box></geometry>
          <material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material></visual>
      </link></model>
    <model name="partition_2"><static>true</static><pose>2.0 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 5.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 5.0 1.0</size></box></geometry>
          <material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material></visual>
      </link></model>
    <model name="crate_1"><static>true</static><pose>-3.0 1.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.8</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
      </link></model>
    <model name="crate_2"><static>true</static><pose>0.5 -2.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.8 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.8 0.6</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
      </link></model>
    <model name="crate_3"><static>true</static><pose>0.5 2.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.9 0.6 0.1 1</ambient><diffuse>0.9 0.6 0.1 1</diffuse></material></visual>
      </link></model>
    <model name="pillar_1"><static>true</static><pose>3.5 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
      </link></model>
    <model name="pillar_2"><static>true</static><pose>-3.5 -0.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
      </link></model>
    <model name="bin_1"><static>true</static><pose>4.0 1.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.3 0.7 0.3 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material></visual>
      </link></model>
  </world>
</sdf>
