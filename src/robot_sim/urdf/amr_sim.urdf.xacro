<?xml version="1.0"?>
<!--
  Simulated version of the AMR (same dimensions as ugv_description/urdf/ugv.urdf.xacro):
    - 0.40 x 0.30 x 0.10 m chassis, differential drive (2 wheels r=0.05 m + 2 casters)
    - RealSense-D455-like RGB-D camera at x=0.20, z=0.15 above base_link
      (same mount as the real robot's default cam_x / cam_z in robot_bringup)
    - IMU
  base_link sits at wheel-axle height (5 cm above the floor).
  Gazebo (Fortress) plugins: DiffDrive (cmd_vel -> wheels, publishes odom + TF),
  JointStatePublisher, RGB-D camera and IMU sensors.
-->
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="wheel_r" value="0.05"/>
  <xacro:property name="wheel_w" value="0.03"/>
  <xacro:property name="wheel_sep" value="0.35"/>
  <xacro:property name="cam_x" value="0.20"/>
  <xacro:property name="cam_z" value="0.15"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <material name="grey"><color rgba="0.55 0.57 0.60 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="green"><color rgba="0.46 0.73 0.0 1"/></material>
  <material name="red"><color rgba="0.8 0.15 0.15 1"/></material>

  <!-- ===== Chassis ===== -->
  <!-- base_link carries no inertia (KDL / robot_state_publisher can't use an inertial
       root link); the chassis mass is on a fixed child, which Gazebo merges into it. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.40 0.30 0.10"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.40 0.30 0.10"/></geometry>
    </collision>
  </link>
  <link name="chassis_inertia">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="4.0"/>
      <inertia ixx="0.0333" ixy="0" ixz="0" iyy="0.0567" iyz="0" izz="0.0833"/>
    </inertial>
  </link>
  <joint name="chassis_inertia_joint" type="fixed">
    <parent link="base_link"/><child link="chassis_inertia"/>
  </joint>

  <!-- Jetson Orin Nano on top (visual only) -->
  <link name="jetson_orin_link">
    <visual>
      <geometry><box size="0.12 0.08 0.02"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="jetson_orin_mount" type="fixed">
    <parent link="base_link"/><child link="jetson_orin_link"/>
    <origin xyz="-0.05 0 0.11"/>
  </joint>

  <!-- ===== Drive wheels ===== -->
  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.00021" ixy="0" ixz="0" iyy="0.000375" iyz="0" izz="0.00021"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${side}_wheel">
      <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_sep/2}"/>
  <xacro:wheel side="right" y="${-wheel_sep/2}"/>

  <!-- ===== Casters (frictionless spheres) ===== -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster">
      <visual><geometry><sphere radius="0.025"/></geometry><material name="black"/></visual>
      <collision><geometry><sphere radius="0.025"/></geometry></collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.0000125" ixy="0" ixz="0" iyy="0.0000125" iyz="0" izz="0.0000125"/>
      </inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/><child link="${name}_caster"/>
      <origin xyz="${x} 0 -0.025"/>
    </joint>
    <gazebo reference="${name}_caster">
      <mu1>0.0</mu1><mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:caster name="front" x="0.15"/>
  <xacro:caster name="rear" x="-0.15"/>

  <!-- ===== RealSense D455 (simulated) ===== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.026 0.124 0.029"/></geometry>
      <material name="green"/>
    </visual>
  </link>
  <joint name="camera_mount" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="${cam_x} 0 ${cam_z}"/>
  </joint>
  <!-- ROS optical convention: z forward, x right, y down -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ===== IMU ===== -->
  <link name="imu_link"/>
  <joint name="imu_mount" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0.1"/>
  </joint>

  <!-- ===== Gazebo sensors ===== -->
  <gazebo reference="camera_link">
    <sensor name="d455" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <topic>camera</topic>
      <ignition_frame_id>camera_optical_frame</ignition_frame_id>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>  <!-- 87 deg, like the D455 depth FOV -->
        <image>
          <width>424</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.1</near><far>8.0</far></clip>
        <depth_camera><clip><near>0.2</near><far>6.0</far></clip></depth_camera>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
    </sensor>
  </gazebo>

  <!-- ===== Gazebo system plugins ===== -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
